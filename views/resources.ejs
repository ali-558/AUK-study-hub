<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>AUK Study Hub | Resources</title>
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/css/main.css" rel="stylesheet">
</head>

<body>
  <header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl d-flex align-items-center justify-content-between">
      <h1 class="sitename">AUK Study Hub</h1>
      <nav>
        <a href="/">Home</a> |
        <a href="/about.html">About</a> |
        <a href="/resources" class="active">Resources</a> |
        <a href="/contact.html">Contact</a>
      </nav>
    </div>
  </header>

  <main class="main py-5">
    <div class="container">
      <h2 class="mb-4 d-flex justify-content-between align-items-center">
        <span>Uploaded Study PDFs</span>
      </h2>

      <!-- Search box -->
      <form class="mb-4" method="GET" action="/resources">
        <div class="input-group">
          <span class="input-group-text">
            <i class="bi bi-search"></i>
          </span>
          <input
            type="text"
            name="q"
            class="form-control"
            placeholder="Search by file name (e.g., DLD Midterm, Math Ch3)..."
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          >
          <button class="btn btn-primary" type="submit">
            Search
          </button>
        </div>
        <% if (searchQuery) { %>
          <p class="mt-2 text-muted small mb-0">
            Showing results for: "<strong><%= searchQuery %></strong>"
          </p>
        <% } %>
      </form>

      <% if (!files || files.length === 0) { %>
        <% if (searchQuery) { %>
          <p class="text-muted">
            No files found matching "<strong><%= searchQuery %></strong>".
          </p>
        <% } else { %>
          <p class="text-muted">No files uploaded yet.</p>
        <% } %>
      <% } else { %>
        <ul class="list-group list-group-flush">
          <% files.forEach(f => {
               const displayName = f.originalName || f.filename || f;
               const fileName    = f.filename || f;
          %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="text-truncate" style="max-width: 70%;">
                <i class="bi bi-filetype-pdf me-2 text-danger"></i>
                <%= displayName %>
              </span>

              <span class="d-flex gap-2">
                <!-- Download button -->
                <a class="btn btn-sm btn-success" href="/files/<%= fileName %>" download>
                  <i class="bi bi-download me-1"></i>Download
                </a>

                <!-- Delete button: only show if logged in AND this is a DB object with _id -->
                <% if (currentUser && f._id) { %>
                  <form
                    action="/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Delete this file?');"
                  >
                    <input type="hidden" name="id" value="<%= f._id %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash me-1"></i>Delete
                    </button>
                  </form>
                <% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </main>

  <!-- AI Assistant Floating Button (opens full AI page) -->
  <div id="ai-helper-container">
    <a
      href="/ai"
      class="ai-helper-bubble"
      title="Open AI Assistant"
    >
      <i class="bi bi-chat-dots"></i>
    </a>
  </div>
  <!-- /AI Assistant Floating Button -->

  <footer class="footer text-center py-3 mt-5 border-top">
    <p>© <%= new Date().getFullYear() %> AUK Study Hub — All Rights Reserved.</p>
  </footer>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/main.js"></script>
</body>
</html>
