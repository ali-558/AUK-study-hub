<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>AUK Study Hub</title>
  <meta name="description" content="Upload and share study PDFs">
  <meta name="keywords" content="AUK, study, PDFs, share">

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon">
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&family=Raleway:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="/assets/css/main.css" rel="stylesheet">
</head>

<body class="index-page">

  <!-- Header -->
  <header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">
      <a href="/" class="logo d-flex align-items-center me-auto">
        <!-- Optional logo image -->
        <!-- <img src="/assets/img/logo.webp" alt="" /> -->
        <h1 class="sitename">AUK Study Hub</h1>
      </a>

<nav id="navmenu" class="navmenu">
  <ul>
    <li><a href="/" class="active">Home</a></li>
    <li><a href="/about.html">About</a></li>
    <li><a href="#upload">Upload</a></li>
    <li><a href="/resources.html">Resources</a></li>
    <li><a href="/contact.html">Contact</a></li>
  </ul>
  <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
</nav>

<a class="btn-getstarted" href="#upload">Get Started</a>

      <a class="btn-getstarted" href="#upload">Get Started</a>
    </div>
  </header>

  <main class="main">

    <!-- Hero Section -->
<section id="hero" class="hero section dark-background d-flex align-items-center justify-content-between">
  <!-- Left side (text content) -->
  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <h2>Learning Today,<br>Leading Tomorrow</h2>
    <p data-aos="fade-up" data-aos-delay="200">
      Share and download study materials with your classmates.
    </p>
    <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
      <a href="#upload" class="btn-get-started">Upload a PDF</a>
    </div>
  </div>

  <!-- Right side (AUK logo) -->
  <div class="hero-logo" data-aos="fade-left" data-aos-delay="200">
    <img src="assets/img/auk logo.jpg" alt="AUK Study Hub Logo" />
  </div>
</section>

    <!-- /Hero Section -->

    <!-- Upload Section -->
    <section id="upload" class="py-5 bg-light">
      <div class="container" data-aos="fade-up">
        <div class="row g-4">
          <div class="col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <h3 class="mb-3">Upload a PDF</h3>
                <form action="/upload" method="POST" enctype="multipart/form-data" class="row g-3">
                  <div class="col-md-8">
                    <input type="file" class="form-control" name="Filename" accept=".pdf" required>
                  </div>
                  <div class="col-md-4 d-grid">
                    <button class="btn btn-primary">Upload</button>
                  </div>
                </form>
                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="alert alert-danger mt-3"><%= error %></div>
                <% } %>
                <% if (typeof ok !== 'undefined' && ok) { %>
                  <div class="alert alert-success mt-3">Uploaded successfully.</div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Uploaded Files -->
          <div class="col-lg-6">
            <div class="card shadow-sm h-100">
              <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h3 class="m-0">Uploaded Files</h3>
                </div>

                <% if (!files || files.length === 0) { %>
                  <p class="text-muted">No files uploaded yet.</p>
                <% } else { %>
                  <ul class="list-group list-group-flush">
                    <% files.forEach(f => { %>
                      <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-truncate" style="max-width: 70%;"><i class="bi bi-filetype-pdf me-2 text-danger"></i><%= f %></span>
                        <span class="d-flex gap-2">
                          <a class="btn btn-sm btn-success" href="/files/<%= f %>" download><i class="bi bi-download me-1"></i>Download</a>
                          <!-- Optional delete (enable if you added the /delete route)
                          <form action="/delete" method="POST" class="m-0">
                            <input type="hidden" name="filename" value="<%= f %>">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                          </form>
                          -->
                        </span>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
                <div class="mt-auto small text-muted pt-3">PDFs are stored locally on this server.</div>
              </div>
            </div>
          </div>
          <!-- /Uploaded Files -->
        </div>
      </div>
    </section>
    <!-- /Upload Section -->

    <!-- You can keep more Mentor sections below if you want -->

  </main>

  <!-- Footer -->
  <footer id="footer" class="footer position-relative light-background">
    <div class="container copyright text-center mt-4">
      <p>© <span><%= new Date().getFullYear() %></span> <strong class="px-1 sitename">AUK Study Hub</strong> <span>All Rights Reserved</span></p>
      <div class="credits">
        <p style="font-size:12px;opacity:.7;">Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a></p>
      </div>
    </div>
  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>
  <script src="/assets/vendor/aos/aos.js"></script>
  <script src="/assets/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="/assets/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>

  <!-- Main JS File -->
  <script src="/assets/js/main.js"></script>
</body>
</html>
