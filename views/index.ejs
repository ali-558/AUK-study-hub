<!DOCTYPE html> 
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>AUK Study Hub</title>
  <meta name="description" content="Upload and share study PDFs">
  <meta name="keywords" content="AUK, study, PDFs, share">

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon">
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&family=Raleway:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="/assets/css/main.css" rel="stylesheet">
</head>

<body class="index-page">

  <!-- Header -->
  <header id="header" class="header d-flex align-items-center sticky-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">
      <a href="/" class="logo d-flex align-items-center me-auto">
        <h1 class="sitename">AUK Study Hub</h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="/" class="active">Home</a></li>
          <li><a href="/about.html">About</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/contact.html">Contact</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <% if (!currentUser) { %>
        <!-- When logged OUT: Get Started opens popup -->
        <button
          type="button"
          class="btn-getstarted d-flex flex-column justify-content-center align-items-center"
          data-bs-toggle="modal"
          data-bs-target="#getStartedModal"
          style="line-height: 1.1;"
        >
          <span>Get Started</span>
          <span class="small" style="font-size:11px;">
            Already have an account? <u>Sign in</u>
          </span>
        </button>
      <% } else { %>
        <!-- When logged IN: show logout -->
        <form action="/logout" method="POST" class="d-inline">
          <button type="submit" class="btn-getstarted">
            Logout (<%= currentUser.email %>)
          </button>
        </form>
      <% } %>
    </div>
  </header>

  <main class="main">

    <!-- Hero Section -->
    <section id="hero" class="hero section dark-background d-flex align-items-center justify-content-between">
      <!-- Left side (text content) -->
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <h2>Learning Today,<br>Leading Tomorrow</h2>
        <p data-aos="fade-up" data-aos-delay="200">
          Share and download study materials with your classmates.
        </p>
        <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
          <% if (currentUser) { %>
            <!-- Rounded Upload button when logged in -->
            <a
              id="hero-upload-btn"
              href="#"
              class="btn-get-started"
            >
              Upload a PDF
            </a>
          <% } else { %>
            <!-- When logged out, go to login page -->
            <a href="/login" class="btn-get-started">Login to Upload</a>
          <% } %>
        </div>
      </div>

      <!-- Right side (AUK logo) -->
      <div class="hero-logo" data-aos="fade-left" data-aos-delay="200">
        <img src="assets/img/auk logo.jpg" alt="AUK Study Hub Logo" />
      </div>
    </section>
    <!-- /Hero Section -->

    <% if (currentUser) { %>
      <!-- Hidden upload form used by the hero Upload button -->
      <form
        id="hero-upload-form"
        action="/upload"
        method="POST"
        enctype="multipart/form-data"
        style="display:none;"
      >
        <input
          type="file"
          id="hero-file-input"
          name="Filename"
          accept=".pdf"
        >
      </form>
    <% } %>

    <!-- Get Started Modal -->
    <div class="modal fade" id="getStartedModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Welcome to AUK Study Hub</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <p class="mb-3">
              Create a free account to upload and download study PDFs.
            </p>
            <div class="d-grid gap-2">
              <a href="/register" class="btn btn-success">
                Get Started – Create an Account
              </a>
              <a href="/login" class="btn btn-outline-secondary">
                I already have an account – Sign in
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /Get Started Modal -->

  </main>

  <!-- Footer -->
  <footer id="footer" class="footer position-relative light-background">
    <div class="container copyright text-center mt-4">
      <p>© <span><%= new Date().getFullYear() %></span>
         <strong class="px-1 sitename">AUK Study Hub</strong>
         <span>All Rights Reserved</span>
      </p>
      <div class="credits">
        <p style="font-size:12px;opacity:.7;">
          Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
        </p>
      </div>
    </div>
  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center">
    <i class="bi bi-arrow-up-short"></i>
  </a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/vendor/php-email-form/validate.js"></script>
  <script src="/assets/vendor/aos/aos.js"></script>
  <script src="/assets/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="/assets/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>

  <!-- Main JS File -->
  <script src="/assets/js/main.js"></script>

  <!-- Hero upload button logic (only works when logged in) -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const uploadBtn = document.getElementById("hero-upload-btn");
      const fileInput = document.getElementById("hero-file-input");
      const form      = document.getElementById("hero-upload-form");

      if (uploadBtn && fileInput && form) {
        uploadBtn.addEventListener("click", (e) => {
          e.preventDefault();
          fileInput.click();
        });

        fileInput.addEventListener("change", () => {
          if (fileInput.files.length > 0) {
            form.submit(); // POST /upload then redirect to /resources
          }
        });
      }
    });
  </script>
</body>
</html>
